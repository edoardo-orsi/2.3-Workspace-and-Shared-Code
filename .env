# --- Postgres Config ---
POSTGRES_USER=rust_dev
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=microservice_db
DATABASE_URL=postgres://rust_dev:supersecret@db:5432/microservice_db

# --- OpenTelemetry / Observability ---
# OTLP Endpoint (The 'otel-lgtm' container listens here for traces/metrics)
# We use 'otel' as the hostname because that is our service name
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4317
OTEL_SERVICE_NAME=my-rust-microservice

# --- Grafana Access ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
